  "paper": {
    "paper_id": "2306.05100",
    "title": "Communication-Efficient Gradient Descent-Accent Methods for Distributed Variational Inequalities: Unified Analysis and Local Updates",
    "sha256": "e3403d50335aef71f975dd1ea908d645873f04aaf0b34d5c9d388cf7b50e14a2"
  },
  "algorithm": {
    "name": "ProxSkip-VIP-FL / deterministic ProxSkip-GDA-FL (Algorithm 2)",
    "citations": [
      "PDF p.7, Section 4 and Algorithm 2 lines 1-13",
      "PDF p.8, Assumption 4.1"
    ],
    "core_mechanisms": [
      "controlled_local_step",
      "corrected_communication_average",
      "control_variate_update"
    ],
    "assumptions": [
      "Each local saddle operator has positive definite symmetric part and is smooth.",
      "Full deterministic operator is an unbiased zero-variance oracle.",
      "Coin outcomes are fixed supported realizations of the stated Bernoulli law.",
      "Initial worker points agree and initial control vectors sum to zero.",
      "Finite trajectories only; no claim of proving communication complexity, nonmonotone theory, or loopless-SVRG variants."
    ]
  },
  "cases": [
    {
      "id": "skip_then_communicate",
      "purpose": "Exercise skip and communication branches with heterogeneous saddle operators and persistent nonzero control variates.",
      "covers": [
        "controlled_local_step",
        "corrected_communication_average",
        "control_variate_update"
      ],
      "inputs": {
        "workers": 2,
        "network": "All workers communicate synchronously through one server; uniform averaging over every worker.",
        "coordinates": "Each row is worker state [u,v] for min_u max_v.",
