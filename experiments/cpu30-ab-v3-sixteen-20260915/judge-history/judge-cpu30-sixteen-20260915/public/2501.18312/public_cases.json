{
  "schema_version": "optirepro.paper_algorithm_contract.v1",
  "paper": {
    "paper_id": "2501.18312",
    "title": "Decentralised convex optimisation with probability-proportional-to-size quantization",
    "sha256": "65ac545e80f254228f3678602b8c08626f469816c43c524769c2043d8c4e2566"
  },
  "algorithm": {
    "name": "PPS Primal-dual method (Algorithm 2)",
    "citations": [
      "PDF pp.6-7, Section 2 and PPS equation (1)",
      "PDF pp.8-9, Section 3, equations (2)-(6)",
      "PDF p.11, Algorithm 2 and coefficient conditions"
    ],
    "core_mechanisms": [
      "signed_pps_quantization",
      "weighted_dual_accumulation",
      "accelerated_dual_updates",
      "weighted_primal_restoration"
    ],
    "assumptions": [
      "Three-dimensional smooth strongly convex primal quadratics and positive-definite diagonal affine A.",
      "Exact zero-noise conjugate oracle and fixed supported PPS uniform draws; both sign masses stay positive.",
      "Coefficient inequalities following Algorithm 2 hold with dual gradient Lipschitz bound L=1.",
      "Finite algebraic validation only: quadratics do not satisfy the paper global uniform bounded-oracle hypothesis, so no probabilistic convergence theorem is asserted.",
      "The decentralized Algorithm 3, barycenter specialization, and Algorithm 1 are outside the tested scope."
    ]
  },
  "cases": [
    {
      "id": "pps_two_positive_coordinates",
      "purpose": "Check signed PPS categorical quantization inside the accelerated primal-dual recursion, varying beta, and weighted primal restoration across initialization and three updates.",
      "covers": [
        "signed_pps_quantization",
        "weighted_dual_accumulation",
        "accelerated_dual_updates",
        "weighted_primal_restoration"
      ],
      "inputs": {
        "network": "Algorithm 2 is the generic affine-constrained primal-dual method, evaluated centrally; no gossip matrix or decentralized Algorithm 3 is used.",
        "primal_objective": "f(x)=sum_j q_j*(x_j-c_j)^2/2 on R^3, subject to A*x=b; A=diag(A_diagonal).",
        "q": [
          1,
          1,
          1
        ],
        "c": [
          -2,
          -1,
          3
        ],
        "A_diagonal": [
          1,
          1,
          1
        ],
        "b": [
          0,
          0,
          0
        ],
        "conjugate": "f_star(v)=sum_j(c_j*v_j+v_j^2/(2*q_j)); exact deterministic stochastic oracle F_star=f_star.",
        "dual_objective": "phi(mu)=dot(mu,b)+f_star(-A^T*mu).",
        "primal_restoring_function": "x(-A^T*mu)=c-diag(A_diagonal/q)*mu.",
        "oracle": "g(mu)=b-A*x(-A^T*mu)=b-A*c+diag(A_diagonal^2/q)*mu; r=1 at all calls, no xi noise.",
        "initialization": "mu0=[0,0,0]; draw PPS at mu0; lambda0=-alpha0/beta0*G0; A0=alpha0.",
        "positive_uniforms": [
          [
            0.1,
            0.2
          ],
          [
            0.1,
            0.9
          ],
          [
            0.6,
            0.8
          ],
          [
            0.2,
            0.7
          ]
        ],
        "negative_uniforms": [
          [
            0.2,
            0.6
          ],
          [
            0.4,
            0.8
          ],
          [
            0.1,
            0.7
          ],
          [
            0.3,
            0.9
          ]
        ],
        "randomness": "At each oracle call k=0,1,2,3 use the corresponding two uniforms for positive and negative signs. For weights max(g,0) and max(-g,0), choose smallest zero-based index whose normalized cumulative weight is strictly greater than u. Use all two draws with replacement separately per sign, and PPS=sum_positive_mass/2*counts_positive-sum_negative_mass/2*counts_negative. Both masses remain positive in these fixtures. No other randomness.",
        "observations": "step0 is initialization after the first PPS call and lambda0. step s=t+1 is after completing the t-th loop. z_used uses beta_t and weighted G0..Gt; mu, PPS_G, mu_hat, lambda correspond to subscript t+1; restored_primal_at_mu uses unquantized restoring function at mu_{t+1}; primal_average includes alpha0*x(-A^T*mu0) through alpha_{t+1}*x(-A^T*mu_{t+1}), divided by their sum. Residual and objective are evaluated at that average.",
        "scope_limitation": "This smooth quadratic fixture checks finite algebraic recurrences. Its dual gradient is bounded on the visited points, but not uniformly on all R^3; it therefore does not instantiate the global bounded-oracle hypothesis of Section 2 or validate the large-deviation theorems."
      },
      "parameters": {
        "T": 3,
        "alpha": [
          1,
          1,
          1.5,
          2
        ],
        "beta": [
          4,
          5,
          6,
          7
        ],
        "beta_minus_one_for_coefficient_condition": 4,
        "r": [
          1,
          1,
          1,
          1
        ],
        "M": [
          2,
          2,
          2,
          2
        ],
        "dual_gradient_L": 1,
        "uniform_draw_interpretation": "Exact decimals in [0,1); no PRNG seed semantics."
