{
  "schema_version": "optirepro.paper_algorithm_contract.v1",
  "paper": {
    "paper_id": "2504.19004",
    "title": "Setwise Coordinate Descent for Dual Asynchronous Decentralized Optimization",
    "sha256": "4fe686f80dfa8d1f1cb35b45614252ef4bb24527d114c6f16bba3f173723915c"
  },
  "algorithm": {
    "name": "Setwise Gauss-Southwell CD (SGS-CD), Algorithm 2",
    "citations": [
      "PDF p.4 Eq.(3), conjugate definition and incidence convention",
      "PDF p.5 Eq.(4), p.6 Eq.(6), p.8 Algorithm 2 and Section 4.2"
    ],
    "core_mechanisms": [
      "dual_conjugate_gradient",
      "restricted_gauss_southwell_selection",
      "single_edge_dual_update_and_endpoint_refresh"
    ],
    "assumptions": [
      "Connected undirected graph, scalar strongly convex smooth local quadratics, serial asynchronous activations.",
      "All incident edges are queried before SGS selection; use current dual gradients with the supplied fixed orientation.",
      "Fixed eta=1/8 is conservative: ||A||^2/min(a)<=4 for these graphs, so eta<=1/L_upper.",
      "Scope is unweighted SGS-CD; SU-CD, coordinate-Lipschitz variants, communication latency, and convergence rates are not tested."
    ]
  },
  "cases": [
    {
      "id": "triangle_cycle",
      "purpose": "Four serial SGS-CD activations on a cycle with redundant dual coordinates.",
      "covers": [
        "dual_conjugate_gradient",
        "restricted_gauss_southwell_selection",
        "single_edge_dual_update_and_endpoint_refresh"
      ],
