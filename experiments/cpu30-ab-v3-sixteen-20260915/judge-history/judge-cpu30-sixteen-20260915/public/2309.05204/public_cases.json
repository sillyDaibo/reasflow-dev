{
  "schema_version": "optirepro.paper_algorithm_contract.v1",
  "paper": {
    "paper_id": "2309.05204",
    "title": "Accelerated Proximal Iterative re-Weighted ℓ1 Alternating Minimization for Image Deblurring",
    "sha256": "67b486882088b75001d71389caaedb3baea251ddc2296f333addda4678ea22a1"
  },
  "algorithm": {
    "name": "PIRL1-AM (Algorithm 1 only; accelerated Algorithm 2 is outside verified scope)",
    "citations": [
      "PDF p.2 Eq. (3), (7), (12), (14)",
      "PDF p.3 Algorithm 1"
    ],
    "core_mechanisms": [
      "previous-z-reweighting",
      "signed-soft-threshold",
      "alternating-blur-solve"
    ],
    "assumptions": [
      "Only the explicitly stated nonaccelerated Algorithm 1 is evaluated. The paper title emphasizes APIRL1-AM, but Algorithm 2 computes y without specifying its feedback into the printed z/u updates; that acceleration mechanism is not uniquely determined and is not claimed covered.",
      "The Eq. (12)/Algorithm 1 denominator is based on previous z, resolving the conflicting bar-z denominator in Eq. (11) by selecting the final explicit pseudocode.",
      "A three-pixel periodic 1D image is a deterministic finite-dimensional instance of the stated linear-operator model; K and gradient are explicitly supplied.",
      "epsilon=0.01 is an explicitly fixed positive smoothing value for numerical separation of threshold branches; no noise generation, clipping, continuation, FFT normalization or early stopping."
    ]
  },
  "cases": [
    {
      "id": "mixed_threshold",
      "purpose": "Exercise changing IRL1 weights, signed/zero soft-threshold branches and a coupled nonidentity blur/gradient linear solve for three complete AM iterations.",
      "covers": [
        "previous-z-reweighting",
        "signed-soft-threshold",
        "alternating-blur-solve"
      ],
      "inputs": {
        "image_shape": [
          1,
          3
        ],
        "flatten_order": "row-major",
        "K": [
          [
            0.75,
            0.25,
            0.0
          ],
          [
            0.0,
            0.75,
            0.25
          ],
          [
            0.25,
            0.0,
            0.75
          ]
        ],
        "gradient_matrix": [
          [
            -1.0,
            1.0,
            0.0
          ],
          [
            0.0,
            -1.0,
            1.0
          ],
          [
            1.0,
            0.0,
            -1.0
          ]
        ],
        "boundary": "periodic forward difference on the three pixels",
        "u0": [
          0,
          1,
          1.2
        ],
        "z0": [
          1,
          0,
          0.5
        ],
        "f": [
          0.5,
          1.5,
          -0.25
        ],
        "objective": "0.5*||K u-f||_2^2 + mu*sum_i |z_i|^p + beta/2*||z-G u||_2^2",
        "randomness": "none"
      },
      "parameters": {
        "mu": 0.2,
        "beta": 1.0,
        "p": 0.1,
        "L": 1,
        "epsilon": 0.01,
        "iterations": 3,
        "variant": "Algorithm 1 PIRL1-AM, not accelerated",
        "weight_base": "previous z_k as printed in Eq. (12) and Algorithm 1, not bar_z_k in Eq. (11)",
        "bar_z_definition": "G @ u_k",
        "observation_timing": "step j is full iteration k=j-1; gradient_before and thresholds are computed before z update; z,u,objective are after their respective updates; objective uses updated z and u"
      },
      "atol": 1e-10,
