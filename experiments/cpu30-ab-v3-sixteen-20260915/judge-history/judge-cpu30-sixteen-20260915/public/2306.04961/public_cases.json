{
  "schema_version": "optirepro.paper_algorithm_contract.v1",
  "paper": {
    "paper_id": "2306.04961",
    "title": "Recovering Simultaneously Structured Data via Non-Convex Iteratively Reweighted Least Squares",
    "sha256": "6486027b50634a90a4ebd40cf40c6b1cca4c32cdbd133dfbfea499fb523aaf48"
  },
  "algorithm": {
    "name": "Algorithm 2.1: IRLS for simultaneously low-rank and row-sparse matrices",
    "citations": [
      "PDF p.5 Definition 2.1, Eqs. (2.2)-(2.6)",
      "PDF p.6 Algorithm 2.1, Eqs. (2.7)-(2.8)",
      "PDF p.8 Eq. (3.1)"
    ],
    "core_mechanisms": [
      "equality-constrained-weighted-least-squares",
      "two-sided-spectral-reweighting",
      "row-sparsity-reweighting",
      "monotone-smoothing-update"
    ],
    "assumptions": [
      "Use the row-sparsity variant, no optional additional column-sparsity term.",
      "Both rank and sparsity estimates are 1, so the printed inconsistent rank/sparsity subscript in Eq. (2.8) coincides and requires no inferred correction.",
      "Initial weight is identity because Algorithm 2.1 explicitly requires it; subsequent operators are nonidentity and both structural penalties are active.",
      "All three iterates are full rank with positive second row norm and smoothing, so zero-smoothing termination is outside scope.",
      "Finite deterministic operator tests do not certify RIP, asymptotic recovery rate or sample complexity."
    ]
  },
