        "signed_features": [
          [
            1,
            -2
          ],
          [
            2,
            -1
          ]
        ],
        "sample_objective": "f[j,i](x)=log(1+exp(-signed_features[j][i]*x)); labels absorbed into signed_features; gradient=-a/(1+exp(a*x))",
        "regularizer": "phi(x)=regularizer_strength*abs(x)",
        "network": "Two connected agents; same constant doubly stochastic A=[[.75,.25],[.25,.75]].",
        "mixing_matrices": [
