  "algorithm": {
    "name": "DPG-RR, Algorithm 1",
    "citations": [
      "PDF p.4 Algorithm 1 and Eqs.(7)-(10)",
      "PDF p.3 Eq.(5), Assumption III.1; p.4 logistic Example 1 and Assumption III.2"
    ],
    "core_mechanisms": [
      "ordered_without_replacement_inner_gradients",
      "post_epoch_consensus",
      "one_prox_per_epoch"
    ],
    "assumptions": [
      "Convex logistic sample losses with bounded gradients and Lipschitz gradients; convex L1 regularizer with bounded subgradients.",
      "Fixed connected undirected two-node network with positive diagonal and doubly stochastic weights.",
      "Explicit Lambda mappings avoid the paper communication-count indexing inconsistency; only numerical Eq.(8) is tested."
    ]
  },
  "cases": [
    {
      "id": "logistic_mixed_sign",
      "purpose": "Three DPG-RR epochs with changing sample order, nontrivial mixing, and L1 shrinkage.",
      "covers": [
        "ordered_without_replacement_inner_gradients",
        "post_epoch_consensus",
        "one_prox_per_epoch"
      ],
      "inputs": {
        "dimension": 1,
        "agents": 2,
        "samples_per_agent": 2,
        "x_initial": [
          1.2,
          -0.8
