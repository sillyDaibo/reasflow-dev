    ],
    "core_mechanisms": [
      "corrected_stochastic_local_updates",
      "full_client_averaging",
      "persistent_zero_sum_control_update"
    ],
    "assumptions": [
      "Strongly convex smooth scalar quadratics; bounded additive iid gradient noise; full client participation.",
      "Control vectors have zero sum initially and retain zero sum.",
      "This is an analysis paper; these tests instantiate its stated SCAFFOLD, not a newly invented algorithm."
    ]
  },
